[Unit]
Description=DocStudio formatter service (FastAPI)
After=network.target

[Service]
User=admin
WorkingDirectory=/home/admin/apps/docstudio-prod/formatter-service
EnvironmentFile=/etc/docstudio/formatter.env
ExecStart=/home/admin/apps/docstudio-prod/formatter-service/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8082 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
